# Copy to .env and fill in. Secrets and machine-specific values only; every other setting
# is in config/keli.json and can be overridden here as KELI_<NAME>.
# PostgreSQL connection string, e.g. postgresql://<user>:<password>@<host>:<port>/<db>
KELI_DATABASE_URL=
# Optional: where the recorder stores images and raw data (default: data/)
# KELI_DATA_DIR=
